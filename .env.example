# CozanetOS Frontend — Environment Variables
# Copy to .env.local and fill in your values

# URL of the cozanet-core backend API (optional — if not set, uses built-in API routes)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── LLM ────────────────────────────────────────────────────────────────────
# Groq API key (required for chat)
GROQ_API_KEY=
# Groq model (optional — defaults to llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# ── Web Search ───────────────────────────────────────────────────────────────
# Tavily API key (required for web search)
TAVILY_API_KEY=

# ── Memory (Supabase) ───────────────────────────────────────────────────────
# Supabase project URL
SUPABASE_URL=https://yjwhpprzyuvlizzdywfg.supabase.co
# Supabase service role key (bypasses RLS — server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=
